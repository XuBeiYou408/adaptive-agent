# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# DeepSeek API（必填）
DEEPSEEK_API_KEY=你的DeepSeek_API密钥
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# HuggingFace 模型缓存目录
HF_HOME=你的HuggingFace缓存路径

# BGE Embedding 模型本地路径（必填）
BGE_MODEL_PATH=你的BGE模型snapshot目录路径

# BGE Reranker 模型本地路径（必填）
RERANKER_MODEL_PATH=你的Reranker模型snapshot目录路径

# 知识库文档目录（PDF/MD 源文件存放位置）
YUAN_SUCAI_PATH=./knowledge

# FAISS 向量库持久化目录
LOCAL_DB_PATH=./local_db
